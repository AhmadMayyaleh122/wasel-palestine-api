    {
      "name": "Incidents",
      "item": [
        {
          "name": "List All Incidents (Public)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/incidents" }
        },
        {
          "name": "List Incidents — Filter Severity + Status + Pagination (Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/incidents?severity=high&status=verified&page=1&limit=10",
              "host": ["{{baseUrl}}"], "path": ["incidents"],
              "query": [
                { "key": "severity", "value": "high" },
                { "key": "status", "value": "verified" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Incident Stats — Raw SQL (Public)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Has totals', () => pm.expect(json.data.totals).to.be.an('object'));",
            "pm.test('Has bySeverity', () => pm.expect(json.data.bySeverity).to.be.an('array'));",

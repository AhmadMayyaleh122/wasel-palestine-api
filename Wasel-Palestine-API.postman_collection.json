          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/incidents/high-severity" }
        },
        {
          "name": "Get Incidents by Checkpoint (Public)",
          "request": { "method": "GET", "url": "{{baseUrl}}/incidents/by-checkpoint/{{checkpointId}}" }
        },
        {
          "name": "Get Incidents by Category (Public)",
          "request": { "method": "GET", "url": "{{baseUrl}}/incidents/by-category/1" }
        },
        {

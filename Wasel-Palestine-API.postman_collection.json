{
  "info": {
    "name": "Wasel Palestine API",
    "description": "Smart Mobility & Checkpoint Intelligence Platform — Full test collection with role-based tokens",
    "_postman_id": "wasel-palestine-v2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "citizenToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "modToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "checkpointId", "value": "", "type": "string" },
    { "key": "incidentId", "value": "", "type": "string" },
    { "key": "reportId", "value": "", "type": "string" },
    { "key": "subscriptionId", "value": "", "type": "string" },
    { "key": "alertId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Status is OK', () => pm.expect(pm.response.json().status).to.equal('OK'));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register — Citizen",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.data && json.data.accessToken) {",
            "  pm.collectionVariables.set('citizenToken', json.data.accessToken);",
            "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
            "  pm.collectionVariables.set('userId', json.data.user.id);",
            "}",
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Has accessToken', () => pm.expect(json.data.accessToken).to.be.a('string'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"citizen@test.com\",\n  \"password\": \"Test1234!\",\n  \"fullName\": \"Test Citizen\",\n  \"phone\": \"+970599000001\"\n}" }
          }
        },
        {
          "name": "Register — Duplicate Email (expect 400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 for duplicate email', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"citizen@test.com\",\n  \"password\": \"Test1234!\",\n  \"fullName\": \"Test Citizen\",\n  \"phone\": \"+970599000001\"\n}" }
          }
        },
        {
          "name": "Login — Citizen → saves citizenToken",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.data && json.data.accessToken) {",
            "  pm.collectionVariables.set('citizenToken', json.data.accessToken);",
            "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
            "  pm.collectionVariables.set('userId', json.data.user.id);",
            "}",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Role is citizen', () => pm.expect(json.data.user.role).to.equal('citizen'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"citizen@test.com\",\n  \"password\": \"Test1234!\"\n}" }
          }
        },
        {
          "name": "Login — Admin → saves adminToken",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.data && json.data.accessToken) {",
            "  pm.collectionVariables.set('adminToken', json.data.accessToken);",
            "}",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Role is admin', () => pm.expect(json.data.user.role).to.equal('admin'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@wasel.com\",\n  \"password\": \"Admin@1234\"\n}" }
          }
        },
        {
          "name": "Login — Moderator → saves modToken",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.data && json.data.accessToken) {",
            "  pm.collectionVariables.set('modToken', json.data.accessToken);",
            "}",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Role is moderator', () => pm.expect(json.data.user.role).to.equal('moderator'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"mod@wasel.com\",\n  \"password\": \"Mod@1234\"\n}" }
          }
        },
        {
          "name": "Login — Wrong Password (expect 401)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401 for wrong password', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"citizen@test.com\",\n  \"password\": \"WrongPassword\"\n}" }
          }
        },
        {
          "name": "Get Current User — Citizen (me)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Has fullName in camelCase', () => pm.expect(json.data.fullName).to.be.a('string'));",
            "pm.test('No snake_case full_name', () => pm.expect(json.data.full_name).to.be.undefined);"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Get Me — No Token (expect 401)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401 without token', () => pm.response.to.have.status(401));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Refresh Token",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.data && json.data.accessToken) {",
            "  pm.collectionVariables.set('citizenToken', json.data.accessToken);",
            "}",
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('New accessToken received', () => pm.expect(json.data.accessToken).to.be.a('string'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{citizenToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        },
        {
          "name": "Logout — Citizen",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{citizenToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Checkpoints",
      "item": [
        {
          "name": "List All Checkpoints (Public)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/checkpoints" }
        },
        {
          "name": "List Checkpoints — Filter by Status + Pagination (Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/checkpoints?status=open&page=1&limit=10",
              "host": ["{{baseUrl}}"], "path": ["checkpoints"],
              "query": [
                { "key": "status", "value": "open" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Create Checkpoint — Admin",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.data && json.data.id) {",
            "  pm.collectionVariables.set('checkpointId', json.data.id);",
            "}",
            "pm.test('Status 201', () => pm.response.to.have.status(201));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },

    {
      "name": "Reports (Crowdsourced)",
      "item": [
        {
          "name": "Submit Report — Citizen",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.data && json.data.id) {",

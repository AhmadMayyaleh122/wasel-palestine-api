            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{modToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/checkpoints",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Huwwara Checkpoint\",\n  \"latitude\": 32.1294,\n  \"longitude\": 35.2771,\n  \"addressText\": \"Huwwara, Nablus\",\n  \"currentStatus\": \"open\"\n}" }

  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET - Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Health check returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var response = pm.response.json();",
                  "pm.test('Health payload is valid', function () {",
                  "  pm.expect(response.status).to.eql('OK');",
                  "  pm.expect(response.version).to.eql('v1');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3000/api/v1/health",
              "host": [
                "localhost"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ],
              "protocol": "http",
              "port": "3000"
            }
          },
          "response": []
        }
      ]
    },
